datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. TABEL PENGGUNA (USER)
model User {
  id             String   @id @default(uuid())
  telegramId     BigInt?  @unique
  fullName       String
  email          String?  @unique
  username       String?  @unique
  passwordHash   String?
  primaryGroupId String?
  createdAt      DateTime @default(now())

  group          SavingsGroup?    @relation(fields: [primaryGroupId], references: [id])
  savingsHistory SavingsHistory[]
  createdInvites InviteLink[]
}

// 2. TABEL KELOMPOK TABUNGAN (SAVINGS GROUP)
model SavingsGroup {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members   User[]
}

// 3. TABEL RIWAYAT TABUNGAN (SAVINGS HISTORY)
model SavingsHistory {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'DEPOSIT' atau 'WITHDRAWAL'
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// 4. TABEL LINK UNDANGAN (INVITE LINK)
model InviteLink {
  id        String   @id @default(uuid())
  code      String   @unique
  creatorId String
  expiresAt DateTime // 5 menit dari pembuatan
  isUsed    Boolean  @default(false)

  creator   User     @relation(fields: [creatorId], references: [id])
}